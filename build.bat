@echo off
setlocal EnableExtensions

cd /d "%~dp0"

set "ROOT=%CD%"
set "SRC_C=%ROOT%\src\c"
set "SRC_CS=%ROOT%\src\cs"
set "BUILD=%ROOT%\build"
set "OBJ=%BUILD%\obj"
set "NATIVE=%BUILD%\native"
set "APP=%BUILD%\app"
set "TOOLS=%BUILD%\tools"

rem The RP1210 side is x86, so force the Visual C++ toolchain to x86.
if /I "%VSCMD_ARG_TGT_ARCH%"=="x86" goto :toolchain_ready

echo [build] Switching Visual C++ toolchain to x86...

if defined VSINSTALLDIR (
    if exist "%VSINSTALLDIR%VC\Auxiliary\Build\vcvarsall.bat" (
        call "%VSINSTALLDIR%VC\Auxiliary\Build\vcvarsall.bat" x86
        if errorlevel 1 goto :fail
        goto :toolchain_ready
    )
)

set "VSWHERE=%ProgramFiles(x86)%\Microsoft Visual Studio\Installer\vswhere.exe"
if not exist "%VSWHERE%" (
    echo ERROR: Visual Studio C++ build tools were not found.
    echo Install "Desktop development with C++" or run from a Visual Studio Developer shell.
    goto :fail
)

set "VSROOT="
for /f "usebackq tokens=*" %%I in (`"%VSWHERE%" -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath`) do set "VSROOT=%%I"

if not defined VSROOT (
    echo ERROR: Could not locate the Visual Studio x86 C++ toolchain.
    goto :fail
)

call "%VSROOT%\VC\Auxiliary\Build\vcvarsall.bat" x86
if errorlevel 1 goto :fail

:toolchain_ready
if /I not "%VSCMD_ARG_TGT_ARCH%"=="x86" (
    echo ERROR: MSVC target is "%VSCMD_ARG_TGT_ARCH%", not x86.
    goto :fail
)

where cl >nul 2>nul
if errorlevel 1 (
    echo ERROR: cl.exe was not found.
    goto :fail
)

where dotnet >nul 2>nul
if errorlevel 1 (
    echo ERROR: dotnet was not found. Install the .NET 10 SDK.
    goto :fail
)

rem Everything generated by this script lives under build\.
if exist "%BUILD%" rmdir /S /Q "%BUILD%"
mkdir "%OBJ%" "%NATIVE%" "%APP%" "%TOOLS%"
if errorlevel 1 goto :fail

echo [1/3] Building native RP1210/CLIP core...
pushd "%OBJ%"

cl /nologo /W3 /O2 /TC /D_CRT_SECURE_NO_WARNINGS /c ^
    "%SRC_C%\rp1210scan.c" ^
    "%SRC_C%\rp1210clip.c" ^
    "%SRC_C%\clip_crypto.c" ^
    "%SRC_C%\clip_cal.c" ^
    "%SRC_C%\cummins_crc.c"
if errorlevel 1 goto :fail_from_obj

link /nologo /DLL /MACHINE:X86 ^
    /DEF:"%SRC_C%\rp1210scan.def" ^
    /OUT:"%NATIVE%\rp1210scan.dll" ^
    /IMPLIB:"%NATIVE%\rp1210scan.lib" ^
    /PDB:"%NATIVE%\rp1210scan.pdb" ^
    rp1210scan.obj rp1210clip.obj clip_crypto.obj clip_cal.obj cummins_crc.obj ^
    kernel32.lib user32.lib
if errorlevel 1 goto :fail_from_obj

echo [2/3] Building CRC utility...
cl /nologo /W3 /O2 /TC /D_CRT_SECURE_NO_WARNINGS /c "%SRC_C%\crc_call.c"
if errorlevel 1 goto :fail_from_obj

link /nologo /MACHINE:X86 ^
    /OUT:"%TOOLS%\crc_call.exe" ^
    crc_call.obj cummins_crc.obj
if errorlevel 1 goto :fail_from_obj

popd

echo [3/3] Publishing WinForms app...
dotnet publish "%SRC_CS%\CumminsCalTransfer.csproj" ^
    -c Release ^
    -r win-x86 ^
    --self-contained true ^
    -o "%APP%"
if errorlevel 1 goto :fail

echo.
echo Build complete:
echo   build\app\CumminsCalTransfer.exe
echo   build\tools\crc_call.exe
echo.
echo Native/intermediate files are also contained under build\.
exit /b 0

:fail_from_obj
popd

:fail
echo.
echo BUILD FAILED
exit /b 1
