<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>

    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <PlatformTarget>x86</PlatformTarget>

    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <PublishTrimmed>false</PublishTrimmed>

    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <ApplicationIcon>caltool.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep the native RP1210/CLIP DLL inside caltool.exe. -->
    <None Remove="rp1210scan.dll" />
    <EmbeddedResource Include="./build/rp1210scan.dll">
      <LogicalName>rp1210scan.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
