<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>

    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <PlatformTarget>x86</PlatformTarget>

    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>

    <AssemblyName>CalibrationTransfer</AssemblyName>
    <ApplicationIcon>caltool.ico</ApplicationIcon>
    <PackageLicenseExpression>GPL-2.0-only</PackageLicenseExpression>

    <BaseOutputPath>..\..\build\dotnet\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>..\..\build\dotnet\obj\</BaseIntermediateOutputPath>

    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- build.bat creates this before dotnet publish runs. -->
    <EmbeddedResource Include="..\..\build\native\rp1210scan.dll">
      <LogicalName>rp1210scan.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
